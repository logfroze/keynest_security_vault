# Supabase Configuration (Optional for local mode; required for multi-device cloud sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Default Argon2id profile ("standard" | "interactive")
NEXT_PUBLIC_KDF_PROFILE=standard

# Optional: Server-side Gemini API key for KeyNest Copilot (never use NEXT_PUBLIC_ prefix!)
GEMINI_API_KEY=
